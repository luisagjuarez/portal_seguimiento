# ---- IMAP (buzón que recibe las solicitudes) ----
IMAP_HOST=localhost
IMAP_PORT=993
IMAP_USER=solicitudes@dovela.com
IMAP_PASSWORD=changeme
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
# Carpeta opcional a la que mover los correos ya procesados (déjalo vacío para solo
# marcarlos como leídos con la bandera \Seen).
IMAP_PROCESSED_FOLDER=

# Texto que debe contener el Asunto para considerarse una solicitud nueva.
SUBJECT_FILTER=Nueva solicitud
# Cada cuántos segundos se revisa el buzón.
POLL_INTERVAL_SECONDS=60

# ---- PostgreSQL ----
# La BD corre fuera de docker-compose, directo en el host (ver
# 00_ARCHIVOS/conexion_db.json). Dentro de Docker, host.docker.internal apunta al
# Postgres del host; si corres el backend directo en el host (fuera de Docker), usa
# localhost en su lugar.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=dovela_control
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dovela_control
POSTGRES_SCHEMA=solicitudes

# ---- Almacenamiento (simula el NFS real) ----
ATTACHMENTS_DIR=/app/data/nfs/adjuntos
MD_DIR=/app/data/nfs/archivos_md

# ---- Valores por defecto de negocio del Módulo 1.1 ----
STATUS_CD_NUEVA=EN ESPERA
TIPO_NUEVA_SOLICITUD=Nuevo

# ---- API HTTP / Chat web (Fase 1.2) ----
# Origen permitido por CORS para que el frontend pueda llamar a la API.
FRONTEND_ORIGIN=http://localhost:5173

# ---- Autenticación (login usuario/contraseña + sesión JWT) ----
# Genera un valor real y distinto por entorno, p.ej.: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme
JWT_EXPIRE_MINUTES=480
